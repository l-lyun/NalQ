# Copy to a web deployment workstation or CI secret store as web-deploy.env.
# This file contains deployment identifiers and public Vite values only.
# Do not add server, database, mail, Notion, authentication, or API secrets.

AWS_REGION=ap-northeast-2
SERVICE_DOMAIN=example.com
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
VITE_API_BASE_URL=https://api.example.com
WEB_S3_BUCKET=CHANGE_ME_PRIVATE_WEB_BUCKET
CLOUDFRONT_DISTRIBUTION_ID=CHANGE_ME_DISTRIBUTION_ID
