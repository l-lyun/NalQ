# Copy to /opt/nalq/production.env on the EC2 host, replace every CHANGE_ME,
# then set owner root:root and mode 600. This file is a shell-compatible env file.

AWS_REGION=ap-northeast-2
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
WEB_ORIGIN=https://app.example.com
DB_BACKUP_S3_URI=s3://CHANGE_ME_PRIVATE_BACKUP_BUCKET/mysql
BACKUP_RETENTION_DAYS=14

# Production deployment accepts only an immutable image digest.
SERVER_IMAGE=CHANGE_ME_REGISTRY/openmd-server@sha256:CHANGE_ME_64_HEX_DIGEST
SERVER_HOST_PORT=8080

MYSQL_DATABASE=openmd
MYSQL_USER=openmd
MYSQL_PASSWORD='CHANGE_ME_RANDOM_DATABASE_PASSWORD'
MYSQL_ROOT_PASSWORD='CHANGE_ME_RANDOM_ROOT_PASSWORD'

OPENMD_CORS_ALLOWED_ORIGINS=https://app.example.com
OPENMD_AUTH_BROWSER_ALLOWED_ORIGINS=https://app.example.com
OPENMD_AUTH_BROWSER_COOKIE_NAME=__Host-openmd_refresh
OPENMD_AUTH_REFRESH_TOKEN_LIFETIME=30d

# Generate these independently outside the repository. Each decoded value must
# contain at least 32 random bytes and be Base64 encoded.
OPENMD_AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_BASE64_32_BYTES
OPENMD_AUTH_EMAIL_CODE_HMAC_SECRET=CHANGE_ME_BASE64_32_BYTES

OPENMD_MAIL_FROM=no-reply@example.com
SPRING_MAIL_HOST=CHANGE_ME_SMTP_HOST
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
SPRING_MAIL_PASSWORD='CHANGE_ME_SMTP_PASSWORD'
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

OPENMD_NOTION_ENABLED=false
OPENMD_NOTION_CLIENT_ID=
OPENMD_NOTION_CLIENT_SECRET=
OPENMD_NOTION_CALLBACK_URI=https://api.example.com/api/v1/integrations/notion/callback
OPENMD_NOTION_ALLOWED_RETURN_URIS=https://app.example.com/learning/import/notion
OPENMD_NOTION_FAILURE_RETURN_URI=https://app.example.com/learning/import/notion
OPENMD_NOTION_TOKEN_KEYS=
OPENMD_NOTION_WRITE_KEY_VERSION=

# Keep generation disabled until a real key and production model are approved.
OPENMD_QUIZ_GENERATION_ENABLED=false
OPENAI_API_KEY=no-key-configured
OPENMD_QUIZ_GENERATION_MODEL=gpt-5.6-luna
OPENMD_QUIZ_GENERATION_REASONING_EFFORT=low
OPENMD_QUIZ_GENERATION_TIMEOUT=60s
OPENMD_QUIZ_GENERATION_NETWORK_RETRY=1
OPENMD_QUIZ_GENERATION_WORKER_COUNT=1
OPENMD_QUIZ_GENERATION_QUEUE_CAPACITY=4
