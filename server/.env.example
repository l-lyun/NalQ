SERVER_PORT=8080

SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/openmd?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
SPRING_DATASOURCE_USERNAME=openmd
SPRING_DATASOURCE_PASSWORD=openmd

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

OPENMD_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enable both only in local or access-controlled development environments.
OPENMD_OPENAPI_ENABLED=false
OPENMD_SWAGGER_UI_ENABLED=false

# Generate independent 32-byte values and Base64 encode them. Never reuse these secrets.
OPENMD_AUTH_ACCESS_TOKEN_SECRET=
OPENMD_AUTH_EMAIL_CODE_HMAC_SECRET=
OPENMD_AUTH_REFRESH_TOKEN_LIFETIME=30d

OPENMD_MAIL_FROM=no-reply@example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
