SERVER_PORT=8080

SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/openmd?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
SPRING_DATASOURCE_USERNAME=openmd
SPRING_DATASOURCE_PASSWORD=openmd

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

OPENMD_CORS_ALLOWED_ORIGINS=http://localhost:5173
OPENMD_AUTH_BROWSER_ALLOWED_ORIGINS=http://localhost:5173
OPENMD_AUTH_BROWSER_COOKIE_NAME=openmd_refresh
OPENMD_AUTH_BROWSER_COOKIE_SECURE=false
OPENMD_AUTH_BROWSER_COOKIE_SAME_SITE=Lax
OPENMD_AUTH_BROWSER_COOKIE_PATH=/

# Enable both only in local or access-controlled development environments.
OPENMD_OPENAPI_ENABLED=false
OPENMD_SWAGGER_UI_ENABLED=false

# Generate independent 32-byte values and Base64 encode them. Never reuse these secrets.
OPENMD_AUTH_ACCESS_TOKEN_SECRET=
OPENMD_AUTH_EMAIL_CODE_HMAC_SECRET=
OPENMD_AUTH_REFRESH_TOKEN_LIFETIME=30d

# Optional. Defaults to SPRING_MAIL_USERNAME. Uncomment and quote to use a display name.
# OPENMD_MAIL_FROM="NalQ <your-email@gmail.com>"
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
# Google Account app password; never commit the real value.
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_STARTTLS_REQUIRED=true
SPRING_MAIL_SSL_CHECK_SERVER_IDENTITY=true
SPRING_MAIL_CONNECTION_TIMEOUT=5000
SPRING_MAIL_READ_TIMEOUT=10000
SPRING_MAIL_WRITE_TIMEOUT=10000

# Quiz generation is disabled unless explicitly enabled with a valid key.
OPENMD_QUIZ_GENERATION_ENABLED=false
OPENAI_API_KEY=
OPENMD_QUIZ_GENERATION_MODEL=gpt-5.6-luna
OPENMD_QUIZ_GENERATION_REASONING_EFFORT=low
OPENMD_QUIZ_GENERATION_TIMEOUT=60s
OPENMD_QUIZ_GENERATION_NETWORK_RETRY=1
OPENMD_QUIZ_GENERATION_WORKER_COUNT=4
OPENMD_QUIZ_GENERATION_QUEUE_CAPACITY=20
