{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 16.18.0"
  },
  "build": {
    "ios-simulator": {
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },
    "ios-simulator-local": {
      "extends": "ios-simulator",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://localhost:15174"
      }
    },
    "device-preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "environment": "production",
      "ios": {
        "autoIncrement": "buildNumber",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6807688566"
      }
    }
  }
}
