EXPO_PUBLIC_WEB_URL=http://localhost:5173

# iOS EAS 빌드에서는 Firebase iOS 앱 설정 파일 경로를 사용한다.
# 로컬 예: GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
# EAS preview/production 환경에서는 같은 이름의 file 변수를 등록한다.

# Android 실기기 EAS 빌드에서는 Firebase Android 앱 설정 파일 경로를 사용한다.
# 로컬 예: GOOGLE_SERVICES_JSON=./google-services.json
# EAS preview 환경에서는 같은 이름의 file 변수를 등록한다.
